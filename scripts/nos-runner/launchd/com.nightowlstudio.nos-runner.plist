<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nightowlstudio.nos-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@LIBEXEC@/supervisor.sh</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>NOS_IMAGE</key>
    <string>@NOS_IMAGE@</string>
@NTFY_ENV@
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ExitTimeOut</key>
  <integer>@EXIT_TIMEOUT@</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/nos-runner.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/nos-runner.log</string>
</dict>
</plist>
