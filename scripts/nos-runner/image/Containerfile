FROM ubuntu:24.04
ARG RUNNER_VERSION=2.338.2
ARG RUNNER_SHA=670adb2f268fe21dcbb58b3db0e0aa9d5b3bddfe2c651481336e561ff86de945
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    git curl jq unzip ca-certificates build-essential sudo libicu74 python3 gnupg \
 && rm -rf /var/lib/apt/lists/*
# GitHub-hosted runners ship gh, and NOS workflows call it (kebab-tax ci.yml `changes`).
ARG GH_VERSION=2.103.3
ARG GH_SHA=ee32df2323c8847f5fac6cb6b4b69ca75828e9329a8f22f677021f7b3306ce63
RUN curl -fsSL -o gh.tgz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_arm64.tar.gz" \
 && echo "${GH_SHA}  gh.tgz" | sha256sum -c - \
 && tar xzf gh.tgz --strip-components=2 -C /usr/local/bin "gh_${GH_VERSION}_linux_arm64/bin/gh" \
 && rm gh.tgz && gh --version
RUN useradd -m -s /bin/bash runner \
 && echo 'runner ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/runner \
 && chmod 0440 /etc/sudoers.d/runner
WORKDIR /home/runner
RUN curl -fsSL -o r.tgz "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-arm64-${RUNNER_VERSION}.tar.gz" \
 && echo "${RUNNER_SHA}  r.tgz" | sha256sum -c - \
 && tar xzf r.tgz && rm r.tgz \
 && ./bin/installdependencies.sh
COPY entrypoint.sh /home/runner/entrypoint.sh
RUN chmod 0755 /home/runner/entrypoint.sh && chown -R runner:runner /home/runner
USER runner
ENTRYPOINT ["/home/runner/entrypoint.sh"]
