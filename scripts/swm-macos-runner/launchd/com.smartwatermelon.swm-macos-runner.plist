<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.smartwatermelon.swm-macos-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@LIBEXEC@/supervisor.sh</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>TART_HOME</key>
    <string>@TART_HOME@</string>
@NTFY_ENV@
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Teardown worst case: stop 60 + delete 120 + runner DELETE 30 + ntfy 20 = 230 s; 300 leaves margin. -->
  <key>ExitTimeOut</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/swm-macos-runner.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/swm-macos-runner.log</string>
</dict>
</plist>
